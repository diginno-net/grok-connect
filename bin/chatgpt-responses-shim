#!/usr/bin/env python3
"""Shim: public Responses API -> ChatGPT Codex backend.

Why it exists: Grok Build serializes the system prompt as an input item with
role="system", while ChatGPT's Codex backend only accepts it in the `instructions`
field (otherwise 400 "System messages are not allowed"). It also returns an empty
`output` array on `response.completed` when store=false, which grok reads as an empty
answer and retries. This shim fixes both, adds the Codex headers, and relays the SSE.

Run: chatgpt-responses-shim [port]   (default 8788)
Point grok at it: base_url = "http://127.0.0.1:8788/v1", api_backend = "responses"

NOTE: that endpoint is internal, not a public API. It carries no stability guarantee -
the request/response shape can change without notice and this shim breaks when it does.
"""
import json, os, subprocess, sys, uuid
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import urllib.request, urllib.error

UPSTREAM = "https://chatgpt.com/backend-api/codex/responses"
PORT = int(sys.argv[1]) if len(sys.argv) > 1 else 8788


def cred(what):
    out = subprocess.run(["grok-cred", what], capture_output=True, text=True)
    if out.returncode != 0:
        raise RuntimeError(out.stderr.strip())
    s = out.stdout.strip()
    return json.loads(s)["access_token"] if s.startswith("{") else s


def hoist_system(payload):
    """Hoist every role=system message into `instructions` and drop it from input."""
    parts, kept = [], []
    for item in payload.get("input", []):
        if isinstance(item, dict) and item.get("role") == "system":
            c = item.get("content")
            if isinstance(c, str):
                parts.append(c)
            elif isinstance(c, list):
                parts.extend(p.get("text", "") for p in c if isinstance(p, dict))
        else:
            kept.append(item)
    payload["input"] = kept
    if parts:
        existing = payload.get("instructions") or ""
        payload["instructions"] = "\n\n".join(([existing] if existing else []) + parts)
    payload["store"] = False
    # The Codex backend never returns reasoning.encrypted_content; leaving the request
    # in place makes grok wait for an item that never arrives.
    payload.pop("include", None)
    return payload


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def handle_one_request(self):
        # The client (grok) closes the keep-alive socket on exit - not an error.
        try:
            super().handle_one_request()
        except (ConnectionResetError, BrokenPipeError):
            self.close_connection = True

    def log_message(self, fmt, *a):
        sys.stderr.write("[shim] " + fmt % a + "\n")

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        try:
            payload = hoist_system(json.loads(self.rfile.read(n) or b"{}"))
        except Exception as e:
            return self.fail(400, f"bad request body: {e}")

        try:
            token, account = cred("chatgpt"), cred("chatgpt-account-id")
        except Exception as e:
            return self.fail(502, f"credential helper failed: {e}")

        req = urllib.request.Request(
            UPSTREAM,
            data=json.dumps(payload).encode(),
            method="POST",
            headers={
                "Content-Type": "application/json",
                "Authorization": f"Bearer {token}",
                "chatgpt-account-id": account,
                "OpenAI-Beta": "responses=experimental",
                "originator": "codex_cli_rs",
                "session_id": str(uuid.uuid4()),
                "Accept": "text/event-stream",
            },
        )
        try:
            up = urllib.request.urlopen(req, timeout=900)
        except urllib.error.HTTPError as e:
            body = e.read()
            self.log_message("upstream %s: %s", e.code, body[:300])
            return self.fail(e.code, body.decode("utf-8", "replace"), raw=True)
        except Exception as e:
            return self.fail(502, f"upstream unreachable: {e}")

        self.send_response(200)
        self.send_header("Content-Type", up.headers.get("Content-Type", "text/event-stream"))
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        dbg = open("/tmp/shim-dump.txt", "ab") if os.environ.get("SHIM_DEBUG") else None
        if dbg:
            dbg.write(b"\n==== REQUEST ====\n" + json.dumps(payload).encode() + b"\n==== RESPONSE ====\n")
        try:
            self.relay(up, dbg)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def relay(self, up, dbg):
        """Relay the SSE stream, patching the terminal event.

        With store=false the Codex backend sends `response.completed` carrying
        `output: []` - the text only ever appears in the deltas. Grok builds its
        assistant item from that final object, sees nothing, calls the response empty
        and retries the whole turn. Here we collect the items from
        `response.output_item.done` and splice them back into `output`.
        """
        items, name, data = [], None, []
        dropped = set()

        def send(chunk):
            self.wfile.write(b"%x\r\n" % len(chunk) + chunk + b"\r\n")
            self.wfile.flush()
            if dbg:
                dbg.write(chunk)

        def flush_event():
            nonlocal name, data
            if name is None and not data:
                return
            # Grok parse SSE bằng enum đóng: gặp variant lạ là lỗi `serialization`
            # KHÔNG retry được, chết cả lượt. Backend Codex thỉnh thoảng chèn
            # `keepalive` (nhịp tim lúc model nghĩ lâu). Mọi event mang nghĩa của
            # Responses API đều nằm dưới `response.*` (hoặc `error`), nên cái gì
            # ngoài đó là nhiễu vận chuyển — bỏ đi an toàn hơn là để nó giết lượt.
            if name and not (name.startswith("response.") or name == "error"):
                if name not in dropped:
                    dropped.add(name)
                    self.log_message("bỏ event lạ: %s", name)
                name, data = None, []
                return
            body = "\n".join(data)
            if name == "response.output_item.done":
                try:
                    item = json.loads(body).get("item")
                    if item:
                        items.append(item)
                except Exception:
                    pass
            elif name in ("response.completed", "response.incomplete"):
                try:
                    d = json.loads(body)
                    if not d.get("response", {}).get("output") and items:
                        d["response"]["output"] = items
                        body = json.dumps(d)
                except Exception:
                    pass
            out = (f"event: {name}\n" if name else "") + f"data: {body}\n\n"
            send(out.encode())
            name, data = None, []

        for raw in up:
            line = raw.decode("utf-8", "replace").rstrip("\n").rstrip("\r")
            if line == "":
                flush_event()
            elif line.startswith("event:"):
                name = line[6:].strip()
            elif line.startswith("data:"):
                data.append(line[5:].lstrip())
            else:
                send(raw)
        flush_event()
        self.wfile.write(b"0\r\n\r\n")
        self.wfile.flush()

    def fail(self, code, msg, raw=False):
        body = msg.encode() if raw else json.dumps({"error": {"message": msg}}).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


if __name__ == "__main__":
    print(f"[shim] listening on http://127.0.0.1:{PORT}/v1/responses -> {UPSTREAM}", file=sys.stderr)
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
